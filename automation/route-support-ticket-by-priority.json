{
  "name": "Route support ticket safely",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "support-ticket",
        "responseMode": "responseNode",
        "options": {}
      },
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 0],
      "id": "webhook-node",
      "name": "Incoming support webhook",
      "webhookId": "support-ticket-route-v2"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://api:8002/tickets",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "external_id",
              "value": "={{ $json.body.external_id }}"
            },
            {
              "name": "customer_id",
              "value": "={{ $json.body.customer_id }}"
            },
            {
              "name": "subject",
              "value": "={{ $json.body.subject }}"
            },
            {
              "name": "description",
              "value": "={{ $json.body.description }}"
            },
            {
              "name": "channel",
              "value": "={{ $json.body.channel }}"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [280, 0],
      "id": "triage-api-node",
      "name": "Create and triage ticket"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "leftValue": "={{ $json.priority }}",
              "rightValue": "high",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [560, 0],
      "id": "priority-branch-node",
      "name": "Is urgent?"
    },
    {
      "parameters": {
        "options": {
          "responseCode": 202
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [840, -100],
      "id": "urgent-response-node",
      "name": "Urgent ticket accepted"
    },
    {
      "parameters": {
        "options": {
          "responseCode": 201
        }
      },
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [840, 120],
      "id": "standard-response-node",
      "name": "Standard ticket accepted"
    }
  ],
  "connections": {
    "Incoming support webhook": {
      "main": [
        [
          {
            "node": "Create and triage ticket",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Create and triage ticket": {
      "main": [
        [
          {
            "node": "Is urgent?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Is urgent?": {
      "main": [
        [
          {
            "node": "Urgent ticket accepted",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Standard ticket accepted",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "support-ticket-route-v2",
