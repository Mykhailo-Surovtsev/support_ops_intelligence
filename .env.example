# "demo" permits local requests without an internal API key. Use "production"
# only with a long API_SHARED_SECRET.
APP_ENV=demo

# Leave both values empty to run the local rules fallback.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional CRM endpoint. It receives an idempotent JSON POST from the durable
# delivery outbox after ticket persistence.
CRM_WEBHOOK_URL=
CRM_API_KEY=

# Leave empty only for a local demo. Required when APP_ENV is not "demo".
API_SHARED_SECRET=

# Keep false only for http://127.0.0.1. Set true behind HTTPS.
N8N_SECURE_COOKIE=false
